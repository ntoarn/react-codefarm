    {
        "rewrites": [
            {
                "source": "/(.*)",
                "destination": "/index.html"
            }
        ],
        "routes": [
            {
                "src": "/(.*)",
                "dest": "index.js",
                "methods": [
                    "GET",
                    "POST",
                    "PUT",
                    "DELETE",
                    "OPTIONS"
                ],
                "headers": {
                    "Access-Control-Allow-Origin": "https://vercel.com/ngotoans-projects/react-codefarm",
                    "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
                    "Access-Control-Allow-Headers": "Content-Type, Authorization"
                }
            }
        ]
    }